APP_ENV=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_BOOTSTRAP_EMAIL=developer@example.local
APP_BOOTSTRAP_PASSWORD=dev-only-change-me-now
DATABASE_URL=postgresql://deutschdeploy:deutschdeploy@localhost:5432/deutschdeploy
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000

# Phase 6 speech media. Local development uses filesystem.
# Railway staging/production must use MEDIA_STORAGE_BACKEND=railway_s3.
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_ROOT=/data/media
MEDIA_MAX_AUDIO_BYTES=25000000

# Railway Bucket variables. In Railway, inject these from the Bucket using Variable References.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=

# Development/test can use mock. Staging/production require openai.
SPEECH_TRANSCRIPTION_PROVIDER=mock
SPEECH_CONSENT_VERSION=2026-09-02-v1
SPEECH_PROVIDER_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
